ACCEPT_EULA="Y"
DB_HOST="database_server"
SA_PASSWORD="abc123!@#"

# Login waarmee de PHP-applicatie verbindt. Heeft alleen de rechten die de
# applicatie gebruikt; 'sa' blijft gereserveerd voor beheer via SSMS.
# Wordt aangemaakt onderaan webserver-setup/pizzeria.sql -- als je het
# wachtwoord hier wijzigt, wijzig het daar ook.
DB_APP_USER="pizzeria_web"
DB_APP_PASSWORD="PizzaWeb-2026-SoleMachina"

# Laat PHP een eigen php.ini laden uit webserver-setup/php-ini/.
# De dubbele punt vooraan betekent "eerst de standaardmap, dan deze map";
# zonder die dubbele punt verdwijnt de sqlsrv-databasedriver.
PHP_INI_SCAN_DIR=":/setup/php-ini"
